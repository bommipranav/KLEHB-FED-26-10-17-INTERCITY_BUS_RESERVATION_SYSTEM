import java.util.Scanner;
public class InterCityBus 
{
    public static void printSeatMap(boolean[] seats)
    {
        System.out.println("\n========== BUS SEAT MAP ==========");
        System.out.println("X = BOOKED");
        System.out.println("----------------------------------");
        for (int i = 0; i < 60; i++) 
        {
            if (seats[i] == true) 
            {
                System.out.print("X   ");
            } else
            {
                System.out.print((i + 1) + "   ");
            }
            if ((i + 1) % 4 == 0)
            {
                System.out.println();
            }
        }
        System.out.println("----------------------------------");
    }

    public static void printTicket(
            String customerName,
            String phone,
            String route,
            String date,
            String busName,
            String departure,
            String arrival,
            String bookedSeats) 
    {
        System.out.println("\n");
        System.out.println("**************");
        System.out.println("*        KL TRAVELS             *");
        System.out.println("*        E-TICKET / BOOKING           *");
        System.out.println("**************");

        System.out.println("* CUSTOMER NAME : " + customerName);
        System.out.println("* PHONE NUMBER  : " + phone);
        System.out.println("* ROUTE         : " + route);
        System.out.println("* DATE          : " + date);
        System.out.println("* BUS           : " + busName);
        System.out.println("* DEPARTURE     : " + departure);
        System.out.println("* ARRIVAL       : " + arrival);
        System.out.println("* SEAT(S)       : " + bookedSeats);
        System.out.println("* STATUS        : CONFIRMED");

        System.out.println("**************");
        System.out.println("* THANK YOU FOR CHOOSING KL TRAVELS *");
        System.out.println("*       HAVE A SAFE JOURNEY!        *");
        System.out.println("**************");
    }


    public static void main(String[] args) 
    {
        Scanner in = new Scanner(System.in);
        System.out.println("==============================================");
        System.out.println("          WELCOME TO KL TRAVELS");
        System.out.println("==============================================");
        System.out.println("\nSELECT YOUR ROUTE");
        System.out.println("1. HYDERABAD <===> VIZAG");
        System.out.println("2. HYDERABAD <===> MUMBAI");
        System.out.println("3. HYDERABAD <===> GOA");
        System.out.println("4. HYDERABAD <===> WARANGAL");
        System.out.println("5. HYDERABAD <===> PUNE");
        System.out.print("\nEnter Route Number: ");
        int route = in.nextInt();
        String selectedRoute = "";
        switch (route) {

            case 1:
                selectedRoute = "HYDERABAD <===> VIZAG";
                break;

            case 2:
                selectedRoute = "HYDERABAD <===> MUMBAI";
                break;

            case 3:
                selectedRoute = "HYDERABAD <===> GOA";
                break;

            case 4:
                selectedRoute = "HYDERABAD <===> WARANGAL";
                break;

            case 5:
                selectedRoute = "HYDERABAD <===> PUNE";
                break;

            default:
                System.out.println("INVALID ROUTE!");
                in.close();
                return;
        }

        System.out.println("\nSelected Route: " + selectedRoute);


        System.out.println("\n==============================================");
        System.out.println("             AVAILABLE DATES");
        System.out.println("==============================================");

        System.out.println("1. 03/09/2026");
        System.out.println("2. 04/09/2026");
        System.out.println("3. 05/09/2026");
        System.out.println("4. 06/09/2026");
        System.out.println("5. 07/09/2026");

        System.out.print("\nSelect Travel Date: ");
        int dateChoice = in.nextInt();

        String selectedDate = "";

        switch (dateChoice) {

            case 1:
                selectedDate = "03/09/2026";
                break;

            case 2:
                selectedDate = "04/09/2026";
                break;

            case 3:
                selectedDate = "05/09/2026";
                break;

            case 4:
                selectedDate = "06/09/2026";
                break;

            case 5:
                selectedDate = "07/09/2026";
                break;

            default:
                System.out.println("INVALID DATE!");
                in.close();
                return;
        }

        System.out.println("\nSelected Date: " + selectedDate);
        System.out.println("\n==============================================");
        System.out.println("              AVAILABLE BUSES");
        System.out.println("==============================================");

        System.out.println("1. KL Morning Express");
        System.out.println("   Departure : 08:00 AM");
        System.out.println("   Arrival   : 08:00 PM");

        System.out.println();

        System.out.println("2. KL Evening Express");
        System.out.println("   Departure : 09:00 PM");
        System.out.println("   Arrival   : 09:00 AM (Next Day)");

        System.out.print("\nChoose Bus: ");
        int busChoice = in.nextInt();

        String busName = "";
        String departure = "";
        String arrival = "";

        switch (busChoice) {

            case 1:
                busName = "KL Morning Express";
                departure = "08:00 AM ; " + selectedDate;
                arrival = "08:00 PM ; " + selectedDate;
                break;

            case 2:
                busName = "KL Evening Express";
                departure = "09:00 PM ; " + selectedDate;
                arrival = "09:00 AM ; Next Day";
                break;

            default:
                System.out.println("INVALID BUS SELECTION!");
                in.close();
                return;
        }

        System.out.println("\n==============================================");
        System.out.println("BUS SELECTED: " + busName);
        System.out.println("DEPARTURE    : " + departure);
        System.out.println("ARRIVAL      : " + arrival);
        System.out.println("==============================================");
        boolean[] seats = new boolean[60];

        char choice = 'Y';

        String bookedSeats = "";
        while (choice == 'Y')
        {

            printSeatMap(seats);

            System.out.print("\nSelect Your Seat (1-60): ");
            int seatNumber = in.nextInt();

            if (seatNumber < 1 || seatNumber > 60) 
            {
                System.out.println("\nINVALID SEAT NUMBER!");
            } 
            else 
            {
                if (seats[seatNumber - 1] == true) 
                {
                    System.out.println("\nSORRY!");
                    System.out.println("SEAT " + seatNumber + " IS ALREADY BOOKED.");
                } 
                else 
                {
                    System.out.println("\nSeat " + seatNumber + " is AVAILABLE.");
                    System.out.print("Confirm Booking? (Y/N): ");
                    char confirm = in.next().charAt(0);
                    if (confirm == 'Y' || confirm == 'y') 
                    {
                        seats[seatNumber - 1] = true;
                        if (bookedSeats.equals("")) 
                        {
                            bookedSeats = "" + seatNumber;
                        } 
                        else
                        {
                            bookedSeats = bookedSeats + ", " + seatNumber;
                        }
                        System.out.println("\n================================");
                        System.out.println("       SEAT BOOKED SUCCESSFULLY");
                        System.out.println("================================");
                        System.out.println("ROUTE      : " + selectedRoute);
                        System.out.println("DATE       : " + selectedDate);
                        System.out.println("BUS        : " + busName);
                        System.out.println("SEAT NUMBER: " + seatNumber);
                        System.out.println("\n========== UPDATED SEAT MAP ==========");
                        printSeatMap(seats);
                    } 
                    else if (confirm == 'N' || confirm == 'n')
                    {
                        System.out.println("\nBOOKING CANCELLED.");
                    } 
                    else
                    {
                        System.out.println("\nINVALID INPUT.");
                    }
                }
            }
            System.out.print("\nBook Another Seat? (Y/N): ");
            choice = in.next().charAt(0);

            if (choice == 'y') {
                choice = 'Y';
            }
        }

        if (bookedSeats.equals("")) {

            System.out.println("\nNO SEATS WERE BOOKED.");
            System.out.println("THANK YOU FOR VISITING KL TRAVELS.");

            in.close();
            return;
        }


        in.nextLine();

        System.out.println("\n==============================================");
        System.out.println("             CUSTOMER DETAILS");
        System.out.println("==============================================");

        System.out.print("Enter Customer Name: ");
        String customerName = in.nextLine();

        System.out.print("Enter Phone Number: ");
        String phone = in.nextLine();


        int otp = 1234;

        System.out.println("\n==============================================");
        System.out.println("           OTP VERIFICATION");
        System.out.println("==============================================");

        System.out.println("OTP has been sent to: " + phone);

        
        System.out.println("(Demo OTP: " + otp + ")");

        System.out.print("\nEnter OTP: ");
        int enteredOtp = in.nextInt();


        if (enteredOtp != otp) {

            System.out.println("\n==============================================");
            System.out.println("             INVALID OTP!");
            System.out.println("       BOOKING COULD NOT BE CONFIRMED.");
            System.out.println("==============================================");

            in.close();
            return;
        }


        System.out.println("\nOTP VERIFIED SUCCESSFULLY!");
        printTicket(
                customerName,
                phone,
                selectedRoute,
                selectedDate,
                busName,
                departure,
                arrival,
                bookedSeats
        );
        System.out.println("\n\n========== FINAL BUS SEAT STATUS ==========");
        printSeatMap(seats);
        System.out.println("\n==============================================");
        System.out.println("       TICKET CONFIRMATION SUCCESSFUL!");
        System.out.println("==============================================");
        System.out.println("Ticket confirmation sent to: " + phone);
        System.out.println("\n");
        
        System.out.println("**************");
        System.out.println("*        KL TRAVELS             *");
        System.out.println("*        E-TICKET / BOOKING           *");
        System.out.println("**************");

        System.out.println("* CUSTOMER NAME : " + customerName);
        System.out.println("* PHONE NUMBER  : " + phone);
        System.out.println("* ROUTE         : " + route);
        System.out.println("* DATE          : " + selectedDate);
        System.out.println("* BUS           : " + busName);
        System.out.println("* DEPARTURE     : " + departure);
        System.out.println("* ARRIVAL       : " + arrival);
        System.out.println("* SEAT(S)       : " + bookedSeats);
        System.out.println("* STATUS        : CONFIRMED");

        System.out.println("**************");
        System.out.println("* THANK YOU FOR CHOOSING KL TRAVELS *");
        System.out.println("*       HAVE A SAFE JOURNEY!        *");
        System.out.println("**************");
        in.close();
    }
}
